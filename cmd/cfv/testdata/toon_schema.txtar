# TOON $schema is inert data — schema resolution requires --schema-map

# TOON with schema-map passes
exec cfv check --schema-map=valid.toon:schema.json valid.toon
stdout '✓'

# TOON with invalid data fails schema validation via schema-map
! exec cfv check --schema-map=invalid.toon:schema.json invalid.toon
stdout '×'
stdout 'error:'

# TOON without $schema passes (syntax only)
exec cfv check plain.toon
stdout '✓'

# TOON without $schema + --require-schema fails
! exec cfv check --require-schema plain.toon
stdout '×'
stdout 'no schema declared'

# TOON with $schema + --require-schema FAILS without schema-map (inert)
! exec cfv check --require-schema valid.toon
stdout '×'
stdout 'no schema declared'

# TOON with $schema + --require-schema + --schema-map passes
exec cfv check --require-schema --schema-map=valid.toon:schema.json valid.toon
stdout '✓'

-- schema.json --
{
  "type": "object",
  "required": ["host", "port"],
  "properties": {
    "$schema": { "type": "string" },
    "host": { "type": "string" },
    "port": { "type": "integer" },
    "debug": { "type": "boolean" }
  },
  "additionalProperties": false
}
-- valid.toon --
"$schema": schema.json
host: localhost
port: 5432
debug: true
-- invalid.toon --
"$schema": schema.json
host: localhost
port: "not_a_number"
-- plain.toon --
host: localhost
port: 5432
