# ============================================================
# .prettierrc auto-detection (Tier 2)
# Proves: .prettierrc applies in Tier 2, .cfv.toml overrides (Tier 1),
# discovery priority, closest-directory-wins, format variants,
# unsupported JS configs skipped, and --no-config disables all.
# ============================================================

# .prettierrc.json tabWidth = 4 replaces the default 2
cp orig.json indent.json
exec cfv format --fix indent.json
exec cat indent.json
stdout '^    "key"'

# --no-config disables all config (falls back to default 2)
cp orig.json indent.json
exec cfv format --fix --no-config indent.json
exec cat indent.json
stdout '^  "key"'

# .cfv.toml overrides .prettierrc (Tier 1 — prettier NOT read)
cp orig.json indent.json
exec cfv format --fix --config=cfv/indent6.toml indent.json
exec cat indent.json
stdout '^      "key"'

# CLI flags override both
cp orig.json indent.json
exec cfv format --fix --config=cfv/indent6.toml --indent=8 indent.json
exec cat indent.json
stdout '^        "key"'

# .prettierrc.json overrides .editorconfig (prettier > EC in Tier 2)
cp orig.json ec/indent.json
exec cfv format --fix ec/indent.json
exec cat ec/indent.json
stdout '^    "key"'

# bare .prettierrc (JSON content) is discovered ahead of .prettierrc.yaml
exec cfv format --fix bare/app.json
exec cat bare/app.json
stdout '^     "k"'

# YAML .prettierrc.yaml maps singleQuote / printWidth
exec cfv format --fix yamlcfg/app.yaml
exec cat yamlcfg/app.yaml
stdout 'key: .value.'

# TOML .prettierrc.toml maps tabWidth (JSONC file)
exec cfv format --fix tomlcfg/app.jsonc
exec cat tomlcfg/app.jsonc
stdout '^   "key"'

# nested directory's .prettierrc wins over the parent's
exec cfv format --fix nested/child/app.json
exec cat nested/child/app.json
stdout '^  "key"'

# unsupported .prettierrc.js is skipped; parent's supported config applies
exec cfv format --fix jsskip/child/app.json
exec cat jsskip/child/app.json
stdout '^   "key"'

-- orig.json --
{"key":"value_that_is_long_enough_to_exceed_the_eighty_column_limit_for_formatting_purposes_here"}
-- .prettierrc.json --
{"tabWidth": 4}
-- cfv/indent6.toml --
[format]
indent = 6

-- ec/.editorconfig --
root = true

[*]
indent_size = 6
-- ec/.prettierrc.json --
{"tabWidth": 4}
-- ec/orig.json --
{"key":"value_that_is_long_enough_to_exceed_the_eighty_column_limit_for_formatting_purposes_here"}

-- bare/.prettierrc --
{"tabWidth": 5}
-- bare/.prettierrc.yaml --
tabWidth: 9
-- bare/app.json --
{"k":"value_that_is_definitely_long_enough_to_push_this_object_past_the_eighty_column_threshold_needed"}

-- yamlcfg/.prettierrc.yaml --
printWidth: 40
singleQuote: true
-- yamlcfg/app.yaml --
key: "value"

-- tomlcfg/.prettierrc.toml --
tabWidth = 3
-- tomlcfg/app.jsonc --
{"key":"value_that_is_long_enough_to_exceed_the_eighty_column_limit_for_formatting_purposes_here"}

-- nested/.prettierrc.json --
{"tabWidth": 8}
-- nested/child/.prettierrc.json --
{"tabWidth": 2}
-- nested/child/app.json --
{"key":"value_that_is_long_enough_to_exceed_the_eighty_column_limit_for_formatting_purposes_here"}

-- jsskip/.prettierrc.json --
{"tabWidth": 3}
-- jsskip/child/.prettierrc.js --
module.exports = { tabWidth: 4 };
-- jsskip/child/app.json --
{"key":"value_that_is_long_enough_to_exceed_the_eighty_column_limit_for_formatting_purposes_here"}
