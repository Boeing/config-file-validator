# TOML $schema is inert data — schema resolution requires --schema-map

# TOML with schema-map passes
exec cfv check --schema-map=valid.toml:schema.json valid.toml
stdout '✓'

# TOML with invalid data fails schema validation via schema-map
! exec cfv check --schema-map=invalid.toml:schema.json invalid.toml
stdout '×'
stdout 'error:'

# TOML without $schema passes (syntax only)
exec cfv check plain.toml
stdout '✓'

# TOML without $schema + --require-schema fails
! exec cfv check --require-schema plain.toml
stdout '×'
stdout 'no schema declared'

# TOML with $schema + --require-schema FAILS without schema-map (inert)
! exec cfv check --require-schema valid.toml
stdout '×'
stdout 'no schema declared'

# TOML with $schema + --require-schema + --schema-map passes
exec cfv check --require-schema --schema-map=valid.toml:schema.json valid.toml
stdout '✓'

-- schema.json --
{
  "type": "object",
  "required": ["host", "port"],
  "properties": {
    "$schema": { "type": "string" },
    "host": { "type": "string" },
    "port": { "type": "integer" },
    "debug": { "type": "boolean" }
  },
  "additionalProperties": false
}
-- valid.toml --
"$schema" = "schema.json"
host = "localhost"
port = 5432
debug = true
-- invalid.toml --
"$schema" = "schema.json"
host = "localhost"
port = "not_a_number"
-- plain.toml --
host = "localhost"
port = 5432
