# Explicit --config wins over auto-discovered .cfv.toml
exec cfv format --fix --config=explicit.toml .
exec cat test.json
stdout '   "a"'

-- .cfv.toml --
[format]
indent = 8
-- explicit.toml --
[format]
indent = 3
-- test.json --
{"a":"value_that_is_long_enough_to_exceed_the_eighty_column_limit_for_formatting_purposes_here"}
