{
  // Top level config
  "database": {
    "host": "db-primary.internal.example.com",
    "port": 5432,
    "options": {
      "timeout_milliseconds": 30000,
      "max_retries_on_failure": 3,
      "connection_pool_size": 25,
    },
  },
  "logging": {
    "level": "info",
    "output_directory": "/var/log/my-application-service/debug",
  },
}
